# --- Gemini ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Chat model used for answering. gemini-1.5-flash is cheap/fast and great for tutoring;
# swap to gemini-1.5-pro for tougher reasoning (proofs, multi-step physics derivations).
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Qdrant (vector database) ---
# Local dev: run `docker run -p 6333:6333 qdrant/qdrant` and use http://localhost:6333
# Production: create a free cluster at https://cloud.qdrant.io and paste its URL + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ncert_chunks

# --- App ---  
FLASK_SECRET_KEY=change-me-to-a-random-string
# Comma-separated subjects available in the UI filter
SUBJECTS=Mathematics,Physics,Chemistry
# Comma-separated grades available in the UI filter. Add "12" here once you've
# ingested class 12 PDFs with `--grade 12` — no other change needed.
GRADES=11,12
